{
  "name": "stocks-ticker",
  "displayName": "股票行情",
  "description": "在命令面板查询港股/美股实时行情，状态栏轮播 + 侧边栏自选股列表。",
  "version": "0.1.8",
  "publisher": "robbie",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stocksTicker.query",
        "title": "查询股票",
        "category": "股票行情",
        "icon": "$(search)"
      },
      {
        "command": "stocksTicker.addToWatchlist",
        "title": "添加到自选股",
        "category": "股票行情",
        "icon": "$(add)"
      },
      {
        "command": "stocksTicker.removeFromWatchlist",
        "title": "从自选股移除",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.showWatchlist",
        "title": "查看自选股",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.toggleStatusBar",
        "title": "切换状态栏显示",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.refresh",
        "title": "立即刷新",
        "category": "股票行情",
        "icon": "$(refresh)"
      },
      {
        "command": "stocksTicker.rename",
        "title": "重命名",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.pin",
        "title": "置顶",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.unpin",
        "title": "取消置顶",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.moveUp",
        "title": "上移",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.moveDown",
        "title": "下移",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.clearAll",
        "title": "清空自选股",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.showDetail",
        "title": "查看详情",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.exportJson",
        "title": "导出自选股",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.importJson",
        "title": "导入自选股",
        "category": "股票行情"
      },
      {
        "command": "stocksTicker.joinRotation",
        "title": "加入轮播",
        "category": "股票行情",
        "icon": "$(add)"
      },
      {
        "command": "stocksTicker.leaveRotation",
        "title": "移出轮播",
        "category": "股票行情",
        "icon": "$(remove)"
      },
      {
        "command": "stocksTicker.addAlert",
        "title": "设置价格提醒",
        "category": "股票行情",
        "icon": "$(bell)"
      },
      {
        "command": "stocksTicker.toggleAlert",
        "title": "启用/停用提醒",
        "category": "股票行情",
        "icon": "$(bell)"
      },
      {
        "command": "stocksTicker.removeAlert",
        "title": "删除提醒",
        "category": "股票行情",
        "icon": "$(trash)"
      },
      {
        "command": "stocksTicker.clearAlerts",
        "title": "清空价格提醒",
        "category": "股票行情"
      }
    ],
    "keybindings": [
      {
        "command": "stocksTicker.query",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stocksTicker",
          "title": "股票行情",
          "icon": "media/sidebar.svg"
        }
      ]
    },
    "views": {
      "stocksTicker": [
        {
          "id": "stocksTicker.watchlist",
          "name": "自选股"
        },
        {
          "id": "stocksTicker.alerts",
          "name": "价格提醒"
        },
        {
          "id": "stocksTicker.welcome",
          "name": "股票行情",
          "when": "stocksTicker.watchlistEmpty"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "stocksTicker.welcome",
        "contents": "欢迎使用股票行情插件。\n\n[查询股票](command:stocksTicker.query)\n[添加到自选股](command:stocksTicker.addToWatchlist)\n\n自选股为空时会显示此欢迎页。添加股票后切换到「自选股」视图查看实时行情。",
        "when": "true"
      },
      {
        "view": "stocksTicker.watchlist",
        "contents": "自选股为空。\n\n[查询并添加股票](command:stocksTicker.query)\n[直接添加代码](command:stocksTicker.addToWatchlist)",
        "when": "stocksTicker.watchlistEmpty"
      },
      {
        "view": "stocksTicker.alerts",
        "contents": "还没有价格提醒。\n\n[设置价格提醒](command:stocksTicker.addAlert)\n\n也可在自选股上右键 →「设置价格提醒」。",
        "when": "stocksTicker.alertsEmpty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stocksTicker.query",
          "when": "view == stocksTicker.watchlist",
          "group": "navigation@1"
        },
        {
          "command": "stocksTicker.addToWatchlist",
          "when": "view == stocksTicker.watchlist",
          "group": "navigation@2"
        },
        {
          "command": "stocksTicker.refresh",
          "when": "view == stocksTicker.watchlist",
          "group": "navigation@3"
        },
        {
          "command": "stocksTicker.clearAll",
          "when": "view == stocksTicker.watchlist",
          "group": "1_actions@1"
        },
        {
          "command": "stocksTicker.exportJson",
          "when": "view == stocksTicker.watchlist",
          "group": "1_actions@2"
        },
        {
          "command": "stocksTicker.importJson",
          "when": "view == stocksTicker.watchlist",
          "group": "1_actions@3"
        },
        {
          "command": "stocksTicker.addAlert",
          "when": "view == stocksTicker.alerts",
          "group": "navigation@1"
        },
        {
          "command": "stocksTicker.clearAlerts",
          "when": "view == stocksTicker.alerts",
          "group": "1_actions@1"
        }
      ],
      "view/item/context": [
        {
          "command": "stocksTicker.pin",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock(WithQuote|NoQuote)$/",
          "group": "inline@1"
        },
        {
          "command": "stocksTicker.unpin",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stockPinned/",
          "group": "inline@1"
        },
        {
          "command": "stocksTicker.joinRotation",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/ && !(viewItem =~ /-rot$/)",
          "group": "inline@2"
        },
        {
          "command": "stocksTicker.leaveRotation",
          "when": "view == stocksTicker.watchlist && viewItem =~ /-rot$/",
          "group": "inline@2"
        },
        {
          "command": "stocksTicker.showDetail",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "navigation@1"
        },
        {
          "command": "stocksTicker.rename",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "5_cutcopypaste@1"
        },
        {
          "command": "stocksTicker.moveUp",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "5_cutcopypaste@2"
        },
        {
          "command": "stocksTicker.moveDown",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "5_cutcopypaste@3"
        },
        {
          "command": "stocksTicker.removeFromWatchlist",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "9_delete@1"
        },
        {
          "command": "stocksTicker.addAlert",
          "when": "view == stocksTicker.watchlist && viewItem =~ /^stock/",
          "group": "navigation@2"
        },
        {
          "command": "stocksTicker.toggleAlert",
          "when": "view == stocksTicker.alerts && viewItem =~ /^alert/",
          "group": "inline@1"
        },
        {
          "command": "stocksTicker.removeAlert",
          "when": "view == stocksTicker.alerts && viewItem =~ /^alert/",
          "group": "inline@2"
        },
        {
          "command": "stocksTicker.toggleAlert",
          "when": "view == stocksTicker.alerts && viewItem =~ /^alert/",
          "group": "navigation@1"
        },
        {
          "command": "stocksTicker.removeAlert",
          "when": "view == stocksTicker.alerts && viewItem =~ /^alert/",
          "group": "9_delete@1"
        }
      ],
      "commandPalette": [
        {
          "command": "stocksTicker.showDetail",
          "when": "false"
        },
        {
          "command": "stocksTicker.joinRotation",
          "when": "false"
        },
        {
          "command": "stocksTicker.leaveRotation",
          "when": "false"
        },
        {
          "command": "stocksTicker.toggleAlert",
          "when": "false"
        },
        {
          "command": "stocksTicker.removeAlert",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "股票行情",
      "properties": {
        "stocksTicker.refreshIntervalMs": {
          "type": "number",
          "default": 8000,
          "minimum": 1000,
          "description": "交易时段刷新间隔（毫秒）。各市场独立判断：开市时用此值，闭市时用非交易时段间隔。"
        },
        "stocksTicker.offHoursRefreshIntervalMs": {
          "type": "number",
          "default": 3600000,
          "minimum": 3000,
          "description": "非交易时段刷新间隔（毫秒），默认 1 小时。各市场闭市时独立使用此值。"
        },
        "stocksTicker.statusBarEnabled": {
          "type": "boolean",
          "default": true,
          "description": "是否显示状态栏轮播行情。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "node scripts/package.js",
    "repackage": "node scripts/repackage.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
